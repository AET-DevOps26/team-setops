# Copy to .env and fill in what you need — only used when running py-intelligence standalone (outside docker-compose). Local-model AI analysis needs no keys.

# --- MongoDB / RAG (optional) ---
MONGODB_URI=
DB_NAME=rag
COLLECTION_NAME=ingestions

# --- Google Gemini API (optional, cloud-mode AI analysis) ---
GOOGLE_API_KEY=

# --- OpenAI-compatible API (optional, cloud fallback) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Service URLs (optional, already default to localhost ports) ---
INGESTION_API_URL=http://localhost:8081
LOGBOOK_API_URL=http://localhost:8082
