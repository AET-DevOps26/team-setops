# ============================================================
# Secret: devpulse-secrets  (in the "setops" namespace)
# ============================================================
# CI/CD pipeline will fill this

apiVersion: v1
kind: Secret
metadata:
  name: devpulse-secrets
  namespace: setops
  labels:
    app.kubernetes.io/part-of: devpulse
type: Opaque
data:
  # PostgreSQL
  POSTGRES_USER: <BASE64_POSTGRES_USER>
  POSTGRES_PASSWORD: <BASE64_POSTGRES_PASSWORD>
  POSTGRES_DB: <BASE64_POSTGRES_DB>
  POSTGRES_URL: <BASE64_POSTGRES_URL>

  # RabbitMQ
  RABBITMQ_USER: <BASE64_RABBITMQ_USER>
  RABBITMQ_PASSWORD: <BASE64_RABBITMQ_PASSWORD>
  RABBITMQ_HOST: <BASE64_RABBITMQ_HOST>
  RABBITMQ_PORT: <BASE64_RABBITMQ_PORT>

  # Python Intelligence Service
  MONGODB_URI: <BASE64_MONGODB_URI>
  GOOGLE_API_KEY: <BASE64_GOOGLE_API_KEY>
  OPENAI_API_KEY: <BASE64_OPENAI_API_KEY>
  OPENAI_BASE_URL: <BASE64_OPENAI_BASE_URL>
