# Copy to .env and fill in what you need — docker compose works without it, local-model AI needs no keys.

# --- Telegram Alerting (optional, bot token from @BotFather, chat ID from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MongoDB / RAG (optional) ---
MONGODB_URI=
DB_NAME=rag
COLLECTION_NAME=ingestions

# --- Google Gemini API (optional, cloud-mode AI analysis) ---
GOOGLE_API_KEY=

# --- OpenAI-compatible API (optional, cloud fallback) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Prometheus basic auth (optional, defaults to admin/devpulse) ---
PROMETHEUS_AUTH_USER=
PROMETHEUS_AUTH_PASSWORD=

# --- Service URLs (leave blank for docker-compose; only set these if running
# py-intelligence standalone outside compose, e.g. http://localhost:8081) ---
INGESTION_API_URL=
LOGBOOK_API_URL=
