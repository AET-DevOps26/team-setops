      "id": 1,
      "title": "Recommended Azure VM RAM Size",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "description": "Sum of JVM memory used by the Spring services plus py-intelligence's resident memory, plus 15% safety headroom.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "cyan"
          },
          "unit": "bytes"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "(sum(jvm_memory_used_bytes) + sum(process_resident_memory_bytes{job=\"py-intelligence\"})) * 1.15",
          "legendFormat": "Azure VM Target Size",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Total Memory In Use",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "description": "Sum of actual JVM memory used by the Spring services plus py-intelligence's resident memory, no headroom applied.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "bytes"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes) + sum(process_resident_memory_bytes{job=\"py-intelligence\"})",
          "legendFormat": "Used RAM",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 6
      },
      "id": 3,
      "title": "Memory Breakdown by Service",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "description": "JVM memory per Spring service, resident memory for py-intelligence.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        }
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"py-intelligence\"}",
          "legendFormat": "{{instance}}",
          "refId": "B"
