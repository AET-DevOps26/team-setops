  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Recommended Azure VM RAM Size",
      "type": "stat",
      "datasource": "Prometheus",
      "description": "Calculated Azure VM sizing budget, summing container memory usage working set + 15% safety headroom.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "cyan"
          },
          "unit": "bytes"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"setops\", container!=\"\"}) * 1.15",
          "legendFormat": "Azure VM Target Size",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "title": "Total Container Memory Limits",
      "type": "stat",
      "datasource": "Prometheus",
      "description": "The sum of the memory limits configured for all containers in the setops namespace.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "bytes"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(container_spec_memory_limit_bytes{namespace=\"setops\", container!=\"\"})",
          "legendFormat": "Memory Limit",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "title": "Total Container Memory In Use",
      "type": "stat",
      "datasource": "Prometheus",
      "description": "Sum of actual physical memory working set used by all containers in the setops namespace.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "bytes"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"setops\", container!=\"\"})",
          "legendFormat": "Used RAM",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "title": "Memory Breakdown by Service",
      "type": "bargauge",
      "datasource": "Prometheus",
      "description": "Actual container memory working set usage per individual service in the setops namespace.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes"
        }
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"setops\", container!=\"\"}) by (container)",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 6
      },
      "id": 5,
      "title": "Memory Growth Timeline",
      "type": "timeseries",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"setops\", container!=\"\"}) by (container)",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    }
  ],
