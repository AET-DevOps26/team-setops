{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Service Status (Uptime)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "up{job=~\"spring-services|py-intelligence\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "title": "Total Operations (Run Counts)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(http_server_requests_seconds_count{uri=\"/api/v1/logs\", status=\"202\"}) or vector(0)",
          "legendFormat": "Logs Ingested",
          "refId": "A"
        },
        {
          "expr": "sum(devpulse_analyses_completed_total) or vector(0)",
          "legendFormat": "AI Analyses Completed",
          "refId": "B"
        },
        {
          "expr": "sum(http_server_requests_seconds_count{uri=~\"/api/v1/incidents.*\"}) or vector(0)",
          "legendFormat": "Incident Queries",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 3,
      "title": "Average Response Latency",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 30,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum(http_request_duration_seconds_sum{handler=\"/api/v1/analyze\"}) / sum(http_request_duration_seconds_count{handler=\"/api/v1/analyze\"})) or vector(0)",
          "legendFormat": "AI Analysis Latency",
          "refId": "B"
        },
        {
          "expr": "(sum(http_server_requests_seconds_sum{uri=\"/api/v1/logs\"}) / sum(http_server_requests_seconds_count{uri=\"/api/v1/logs\"})) or vector(0)",
          "legendFormat": "Log Ingestion Latency",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 10
      },
      "id": 4,
      "title": "Application Activity Timeline (Runs)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear"
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/api/v1/logs\", status=\"202\"}[2m])) or vector(0)",
          "legendFormat": "Log Ingestions",
          "refId": "A"
        },
        {
          "expr": "sum(increase(devpulse_analyses_completed_total[2m])) or vector(0)",
          "legendFormat": "AI Analyses",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "id": 5,
      "title": "Errors & Failures (Total Counts)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "(sum(http_server_requests_seconds_count{status=~\"5..\", uri!~\"/actuator.*|/metrics.*|/health.*\"}) or vector(0)) + (sum(http_requests_total{status=\"5xx\", handler!~\"/metrics|/health\"}) or vector(0))",
          "legendFormat": "HTTP 5xx Server Errors",
          "refId": "A"
        },
        {
          "expr": "(sum(http_server_requests_seconds_count{status=~\"4..\", uri!~\"/actuator.*|/metrics.*|/health.*\"}) or vector(0)) + (sum(http_requests_total{status=\"4xx\", handler!~\"/metrics|/health\"}) or vector(0))",
          "legendFormat": "HTTP 4xx Client Errors",
          "refId": "B"
        }
      ]
    },
    {
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 6,
      "title": "Inference Mode (Local vs Cloud)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(devpulse_inference_total{mode=\"local\"}) or vector(0)",
          "legendFormat": "Local",
          "refId": "A"
        },
        {
          "expr": "sum(devpulse_inference_total{mode=\"cloud\"}) or vector(0)",
          "legendFormat": "Cloud",
          "refId": "B"
        }
      ]
    },
    {
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 7,
      "title": "Gemini \u2192 OpenAI Fallbacks",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-datasource"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(devpulse_inference_fallback_total) or vector(0)",
          "legendFormat": "Fallbacks",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
