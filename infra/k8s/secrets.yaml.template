# ============================================================
# Secret: devpulse-secrets  (in the "setops" namespace)
# ============================================================
# A Secret stores sensitive values (passwords, API keys).
# Values must be base64-encoded (not encrypted — just encoded).
#
# HOW TO USE:
#   1. Copy this file:  cp secrets.yaml.template secrets.yaml
#   2. Replace each <BASE64_...> placeholder with your value:
#        echo -n "your-value" | base64
#      Example:
#        echo -n "password" | base64   →   cGFzc3dvcmQ=
#   3. Apply:  kubectl apply -f infra/k8s/secrets.yaml
#
# ⚠️  NEVER commit secrets.yaml to Git!
#     Only this .template file should be checked in.
# ============================================================

apiVersion: v1
kind: Secret
metadata:
  name: devpulse-secrets
  namespace: setops
  labels:
    app.kubernetes.io/part-of: devpulse
type: Opaque
data:
  # echo -n "user" | base64       →  dXNlcg==
  POSTGRES_USER: <BASE64_POSTGRES_USER>
  # echo -n "password" | base64   →  cGFzc3dvcmQ=
  POSTGRES_PASSWORD: <BASE64_POSTGRES_PASSWORD>
  # echo -n "appdb" | base64      →  YXBwZGI=
  POSTGRES_DB: <BASE64_POSTGRES_DB>

  # RabbitMQ
  RABBITMQ_USER: <BASE64_RABBITMQ_USER>
  RABBITMQ_PASSWORD: <BASE64_RABBITMQ_PASSWORD>

  # Python Intelligence Service
  MONGODB_URI: <BASE64_MONGODB_URI>
  GOOGLE_API_KEY: <BASE64_GOOGLE_API_KEY>
